class Solution {
    static final int MOD = 1000000007;

    // Segment tree arrays
    long[] sum;      // Sum of squares of distinct counts
    long[] lazy;     // Lazy propagation for linear increment values
    long[] sumV;     // Sum of current distinct counts in range

    public int sumCounts(int[] nums) {
        int n = nums.length;
        sum = new long[4 * n];
        lazy = new long[4 * n];
        sumV = new long[4 * n];

        // To store the last seen index of each element
        java.util.Map<Integer, Integer> lastSeen = new java.util.HashMap<>();

        long totalSum = 0;
        long currentSumOfSquares = 0;

        for (int i = 0; i < n; i++) {
            int x = nums[i];
            int last = lastSeen.getOrDefault(x, -1);

            // Update distinct counts for range [last + 1, i] by +1
            // (cnt + 1)^2 = cnt^2 + 2*cnt + 1
            if (last + 1 <= i) {
                update(1, 0, n - 1, last + 1, i);
            }

            lastSeen.put(x, i);

            // Query sum of squares for all subarrays ending at i (range [0, i])
            currentSumOfSquares = querySum(1, 0, n - 1, 0, i);
            totalSum = (totalSum + currentSumOfSquares) % MOD;
        }

        return (int) totalSum;
    }

    private void pushDown(int node, int l, int r) {
        if (lazy[node] != 0) {
            int mid = (l + r) / 2;
            apply(2 * node, l, mid, lazy[node]);
            apply(2 * node + 1, mid + 1, r, lazy[node]);
            lazy[node] = 0;
        }
    }

    private void apply(int node, int l, int r, long val) {
        // sum' = sum + 2 * sumV * val + val^2 * length
        long len = (r - l + 1);
        sum[node] = (sum[node] + 2 * sumV[node] % MOD * val % val MOD + val * val % MOD * len) % MOD;
        sumV[node] = (sumV[node] + val * len) % MOD;
        lazy[node] = (lazy[node] + val) % MOD;
    }

    private void update(int node, int l, int r, int ql, int qr) {
        if (ql <= l && r <= qr) {
            apply(node, l, r, 1);
            return;
        }
        pushDown(node, l, r);
        int mid = (l + r) / 2;
        if (ql <= mid) update(2 * node, l, mid, ql, qr);
        if (qr > mid) update(2 * node + 1, mid + 1, r, ql, qr);
        sum[node] = (sum[2 * node] + sum[2 * node + 1]) % MOD;
        sumV[node] = (sumV[2 * node] + sumV[2 * node + 1]) % MOD;
    }

    private long querySum(int node, int l, int r, int ql, int qr) {
        if (ql <= l && r <= qr) {
            return sum[node];
        }
        pushDown(node, l, r);
        int mid = (l + r) / 2;
        long res = 0;
        if (ql <= mid) res = (res + querySum(2 * node, l, mid, ql, qr)) % MOD;
        if (qr > mid) res = (res + querySum(2 * node + 1, mid + 1, r, ql, qr)) % MOD;
        return res;
    }
}
